${FAVORITES_ADD_BUTTON}         id=clrcap.CCClient:id/btn_add
${FAVORITES_SEARCH_BAR}         id=clrcap.CCClient:id/et_search
${FAVORITES_ADD_CONTACT_BTN}    id=clrcap.CCClient:id/fb_add
${FAVORITES_HEART_BUTTON}       id=clrcap.CCClient:id/cb_favorite
${FAVORITES_CONTACT_ROW}        id=clrcap.CCClient:id/textViewFullname
${FAVORITES_EDIT_BTN}           id=clrcap.CCClient:id/btn_edit_fav_activity
${FAVORITES_REMOVE_BTN}         id=clrcap.CCClient:id/iv_contact_favorite
${FAVORITES_SAVE_BTN}           id=clrcap.CCClient:id/btn_done
${FAVORITES_EMPTY_TEXT}         id=clrcap.CCClient:id/tv_empty_favorites_list

    "Web Resource Template": {
        "prefix": "webresourcetemplate",
        "body": [
            "*** Settings ***",
            "# Load your Web Automation library, replace path with your project library path",
            "Library    ${1:\\${CURDIR\\}/../../../panacea_runtime/WebAppTestLibrary/}",
            "# Common utility libraries - usually required for keywords and utilities",
            "Library    Collections",
            "Library    OperatingSystem",
            "Library    String",
            "Library    DateTime",
            "# Path to your locators resource file, update per project",
            "Resource    ${2:../locators/web_locators.resource}",
            "",
            "*** Variables ***",
            "# Directory where test reports will be stored",
            "\\${REPORT_DIR}    None  # Can be set dynamically in Suite Setup",
            "# YAML file path for test data, replace with your config path",
            "\\${TEST_DATA_YAML_FILE}    \\${CURDIR}/../../ConfigFiles/testdata.yaml",
            "\\${running_from_runner}    None",
            "\\${URL}    None",
            "\\${BROWSER}    None",
            "\\${DRIVER_PATH}    None",
            "",
            "*** Keywords ***",
            "# Keyword to fetch values from YAML file",
            "Get Value From Yaml File",
            "    [Arguments]    \\${section}    \\${key}  # Pass YAML section and key",
            "    \\${yaml_string}=    Get File    \\${TEST_DATA_YAML_FILE}  # Reads the YAML as string",
            "    \\${data}=    Evaluate    __import__('yaml').safe_load('''\\${yaml_string}''')  # Parse YAML",
            "    \\${section_data}=    Get From Dictionary    \\${data}    \\${section}  # Get section dictionary",
            "    \\${value}=    Get From Dictionary    \\${section_data}    \\${key}  # Get key value",
            "    RETURN    \\${value}  # Return the fetched value",
            "",
            "# Local execution configuration - sets browser and driver path",
            "Local Execution Configuration",
            "    \\${BROWSER}=    Get Value From Yaml File    browser_config    browser",
            "    Set Suite Variable    \\${BROWSER}",
            "    \\${DRIVER_PATH}=    Get Value From Yaml File    browser_config    driver_path",
            "    Set Suite Variable    \\${DRIVER_PATH}",
            "    Set Default Directory And Create Folder",
            "",
            "Set Default Directory And Create Folder",
            "    \\${current_timestamp}=    Get Current Date    result_format=%d-%m-%y_%H-%M-%S",
            "    \\${folder_path}=    Join Path    \\${REPORT_DIR}    \\${current_timestamp}    \\${BROWSER}    # Create timestamped folder",
            "    Create Directory    \\${folder_path}",
            "    Set Global Variable    \\${REPORT_DIR}    \\${folder_path}",
            "",
            "# Suite Setup executed once before all tests in suite",
            "Suite Setup",
            "    \\${running_from_runner}=    Get Environment Variable    RUNNING_FROM_RUNNER    default=False",
            "    Run Keyword If    '\\${running_from_runner}' == 'False'    Local Execution Configuration",
            "",
            "# Suite Teardown executed once after all tests in suite",
            "Suite Teardown",
            "    Close Browser  # Closes the browser after suite execution",
            "",
            "Test Setup",
            "    Log    Initializing test prerequisites and configuring test environment",
            "    # Add your actual setup steps here",
            "",
            "Test Teardown",
            "    Log    Releasing test resources and restoring system state",
            "    # Add your actual teardown steps here",
            "",
        ],
        "description": "Web Automation Resource File Template with detailed inline comments for team usage"
    },

    "Mobile Resource Template": {
        "prefix": "mobileresourcetemplate",
        "body": [
            "*** Settings ***",
            "# Load your Mobile Automation Library, replace with project path",
            "Library    ${1:\\${CURDIR\\}/../../../panacea_runtime/MobAppTestLibrary/}    run_on_failure=Capture Page Screenshot",
            "# Utility libraries - keep unless project requires changes",
            "Library    JSONLibrary",
            "Library    Collections",
            "Library    OperatingSystem",
            "Library    String",
            "Library    DateTime",
            "# Mobile locators file path",
            "Variables    ${2:../locators/mobile_locators.py}",
            "# Platform utility functions for Android/iOS",
            "",
            "*** Variables ***",
            "# YAML test data file path",
            "\\${TEST_DATA_YAML_FILE}    \\${CURDIR}/../../ConfigFiles/testdata.yaml",
            "# Device details JSON file",
            "\\${DEVICE_DETAILS_JSON}    \\${CURDIR}/../../ConfigFiles/deviceDetails.json",
            "# Device placeholders to be set at runtime",
            "\\${DEVICE_NAME}    None",
            "\\${REPORT_DIRECTORY}    None",
            "\\${DEVICE_AS_DICTIONARY}    None",
            "\\${APPIUM_URL}    None",
            "\\${UDID}    None",
            "\\${ADB_PROCESS}    None",
            "\\${REPORT_DIR}     \\${CURDIR}/../../TestResults",
            "",
            "*** Keywords ***",
            "# Load device info from JSON file, replace DEVICE_NAME with actual device key",
            "Load Device Info",
            "   [Arguments]    \\${DEVICE_NAME}",
            "   \\${json_data}=    Load JSON From File    \\${DEVICE_DETAILS_JSON}  # Load JSON content",
            "   \\${device}=       Get From Dictionary   \\${json_data}    \\${DEVICE_NAME}  # Get device info",
            "   Set Suite Variable    \\${DEVICE_AS_DICTIONARY}    \\${device}",
            "   \\${APPIUM_URL}=    Get From Dictionary    \\${json_data['\\${DEVICE_NAME}']}    appium-url  # Appium server URL",
            "   Set Global Variable    \\${APPIUM_URL}    \\${APPIUM_URL}",
            "",
            "# Suite Setup - executed once before all tests",
            "Suite Setup",
            "   \\${running_from_runner}=    Get Environment Variable    RUNNING_FROM_RUNNER    default=False",
            "   Run Keyword If    '\\${running_from_runner}' == 'False'    Set Device Name And Load Info",
            "   Load Device Info    \\${DEVICE_NAME}",
            "   Set Suite Variable    \\${REPORT_DIRECTORY}    \\${None}",
            "   Run Keyword If    '\\${running_from_runner}' != 'True'    Set Default Directory And Create Folder",
            "   Start Appium locally",
            "   Start Device Logs locally for Android",
            "",
            "# Set device name and load info dynamically from YAML",
            "Set Device Name And Load Info",
            "   \\${DEVICE_NAME}=    Get Value From Yaml File    devices    device_name",
            "   Set Suite Variable    \\${DEVICE_NAME}",
            "",
            "# Read value from YAML file",
            "Get Value From Yaml File",
            "   [Arguments]    \\${section}    \\${key}",
            "   \\${yaml_string}=    Get File    \\${TEST_DATA_YAML_FILE}    # Read YAML file as string",
            "   \\${data}=    Evaluate    __import__('yaml').safe_load('''\\${yaml_string}''')  # Parse YAML",
            "   \\${section_data}=    Get From Dictionary    \\${data}    \\${section}",
            "   \\${value}=    Get From Dictionary    \\${section_data}    \\${key}",
		    "   RETURN    \\${value}",
            "",
            "Set Default Directory And Create Folder",
            "   \\${current_timestamp}=    Get Current Date    result_format=%d-%m-%y_%H-%M-%S",
            "   \\${folder_path}=    Join Path    \\${REPORT_DIR}    \\${current_timestamp}    \\${DEVICE_NAME}    # Create timestamped folder",
            "   Create Directory    \\${folder_path}",
            "   Set Global Variable    \\${REPORT_DIR}    \\${folder_path}",
            "",
            "# Suite Teardown keyword - runs once per suite",
            "Suite Teardown",
            "   close_application",
            "   Stop Device Logs locally for Android",
            "   Stop Appium locally",
            "",
            "Start Appium locally",
            "    \\${APPIUM_URL}=    start_appium_service    \\${REPORT_DIR}    server_url=\\${APPIUM_URL}",
            "",
            "Stop Appium locally",
            "    stop_appium_service    \\${APPIUM_URL}",
            "",
            "Start Device Logs locally for Android",
            "    \\${adb_process}=    start_adb_log    \\${UDID}    \\${REPORT_DIR}/adb.log",
            "    Set Global Variable    \\${ADB_PROCESS}    \\${adb_process}",
            "",
            "Stop Device Logs locally for Android",
            "    stop_adb_log    \\${ADB_PROCESS}",
            "",
            "Test Setup",
            "    Log    Initializing test prerequisites and configuring test environment",
            "    # Add your actual setup steps here",
            "",
            "Test Teardown",
            "    Log    Releasing test resources and restoring system state",
            "    # Add your actual teardown steps here",
            "",
            

    ],
    "description": "Mobile Automation Resource File Template with inline comments for new users"
}


